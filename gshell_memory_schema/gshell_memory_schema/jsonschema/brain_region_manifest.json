{
  "$defs": {
    "BrainRegionExtension": {
      "additionalProperties": false,
      "description": "An opt-in region beyond the 5 defaults.\n\nMirrors RegionDef's structure but lives under `extensions:` in the\nmanifest so that 5.0 readers can ignore it.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "core_files": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Core Files",
          "type": "array"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "on_demand_files": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "On Demand Files",
          "type": "array"
        }
      },
      "required": [
        "display"
      ],
      "title": "BrainRegionExtension",
      "type": "object"
    },
    "RegionDef": {
      "properties": {
        "core_files": {
          "items": {
            "$ref": "#/$defs/RegionFile"
          },
          "title": "Core Files",
          "type": "array"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "on_demand_files": {
          "items": {
            "$ref": "#/$defs/RegionFile"
          },
          "title": "On Demand Files",
          "type": "array"
        }
      },
      "required": [
        "display",
        "core_files",
        "on_demand_files"
      ],
      "title": "RegionDef",
      "type": "object"
    },
    "RegionFile": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "RegionFile",
      "type": "object"
    }
  },
  "properties": {
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/BrainRegionExtension"
      },
      "title": "Extensions",
      "type": "object"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "regions": {
      "additionalProperties": {
        "$ref": "#/$defs/RegionDef"
      },
      "title": "Regions",
      "type": "object"
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "default": "5.1",
      "title": "Schema Version"
    }
  },
  "required": [
    "generated_at",
    "regions"
  ],
  "title": "BrainRegionManifest",
  "type": "object"
}
