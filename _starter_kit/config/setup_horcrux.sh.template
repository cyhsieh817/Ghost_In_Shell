#!/bin/bash
# setup_horcrux.sh: Agent 分靈體喚醒儀式

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}✨ 開始 AI Agent 分靈體喚醒儀式...${NC}"

# 1. 檢查 .env
if [ -f .env ]; then
    echo -e "${RED}⚠️  .env 檔案已存在！${NC}"
    read -p "是否備份並覆蓋？ (y/n): " overwrite
    if [[ $overwrite != "y" ]]; then echo "已取消。"; exit 0; fi
    mv .env .env.bak
fi

# 2. 收集資訊
echo ""
echo -e "${GREEN}1. 命名儀式${NC}"
read -p "請為此分靈體取名 (ID): " agent_id
[[ -z "$agent_id" ]] && agent_id="Worker_$(date +%s)"

echo ""
echo -e "${GREEN}2. 連結大腦${NC}"
read -p "請輸入 Google Drive 中 Agent System 的絕對路徑: " vault_path

if [[ ! -d "$vault_path" ]]; then
    echo -e "${RED}❌ 找不到路徑: $vault_path${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}3. 授權通訊 (Telegram)${NC}"
read -p "Bot Token (選填): " telegram_token
read -p "Chat ID (選填): " telegram_chat

# 3. 建立 .env
cat > .env <<EOF
AGENT_ID=$agent_id
PRIORITY=SECONDARY
VAULT_PATH="$vault_path"
TELEGRAM_BOT_TOKEN=$telegram_token
TELEGRAM_CHAT_ID=$telegram_chat
EOF

# 4. 建立分區與註冊
system_dir="$vault_path/🧠_Agent_System/99_System"
if [[ -d "$system_dir" ]]; then
    mkdir -p "$system_dir/Worker_Inbox/$agent_id"
    timestamp=$(date "+%Y-%m-%d %H:%M")
    if [[ -f "$system_dir/REGISTRY.md" ]]; then
        echo "| **$agent_id** | $(hostname) | SECONDARY | 🟢 ACTIVE | $timestamp |" >> "$system_dir/REGISTRY.md"
    fi
    echo -e "${GREEN}✅ 喚醒成功！${NC}"
else
    echo -e "${RED}⚠️  無法找到 99_System，請確認大腦結構。${NC}"
fi

chmod +x run_heartbeat.sh
