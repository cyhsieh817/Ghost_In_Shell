{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/your/workspace/scripts/memory_session_log.py --runtime claude-code --trigger stop-hook",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
