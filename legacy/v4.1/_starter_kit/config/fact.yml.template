# fact.yml — Hot Layer (L1)
# Loaded every session via CLAUDE.md @import.
# Only active, frequently-needed facts. Keep under 200 lines.
# Cold storage: fact_archive.yml (evaluated tools), fact_decisions.yml (history),
#               fact_governance.yml (archive routing, sanctum registry)
# Last updated: {{DATE}}

---

user:
  name: "{{USER_NAME}}"
  call_as: "{{CALL_AS}}"
  language: "{{PRIMARY_LANGUAGE}}"
  timezone: "{{USER_TIMEZONE}}"

  roles:
    - { org: "{{ORG_1}}", title: "{{TITLE_1}}" }

  preferences:
    communication: ["{{COMMUNICATION_STYLE}}"]
    tech_stack: ["{{TECH_STACK}}"]
    task_reminders:
      tool: "{{REMINDER_TOOL}}"
      rules:
        - "Trigger on task/reminder keywords → create reminder immediately"
        - "Trigger on deferral intent (later, tomorrow, next time) → capture task summary + suggested time"

  sensitive_areas: ["{{SENSITIVE_AREAS}}"]

---

system:
  identity: "{{AGENT_NAME}}"
  emoji: "{{AGENT_EMOJI}}"

  paths:
    workspace: "{{WORKSPACE_PATH}}"
    vault: "{{VAULT_PATH}}"
    memory: "{{WORKSPACE_PATH}}/memory"
    scripts: "{{WORKSPACE_PATH}}/scripts"

---

rules:
  - "{{RULE_1}}"
  - "{{RULE_2}}"
  - "{{RULE_3}}"
  - "Read files before editing — never blind-edit"
  - "Mark deletions with _DELETE_ prefix — never rm"
  - "Follow archive routing in fact_governance.yml when filing artifacts"

---

# Subagent Model Tiering
# Fixed: orchestrator passes model param directly, zero judgment
# Conditional: default model + upgrade rules (see AGENTS.md)
# Unlisted: inherit parent model (never downgrade)
agent_model_tiers:
  last_updated: "{{DATE}}"
  fixed:
    # agent_name: "model"
    # Example: analyst: "opus"
  conditional:
    # agent_name: { default: "sonnet", upgrade_to: "opus", see: "AGENTS.md" }
  fallback: "inherit"

---

# Sanctum Governance — three-tier file protection
# Full registry lives in memory/fact_governance.yml → sanctum_registry
# Tier reference:
#   core              → C-layer guarded (real-time friction on violation, future)
#   extended          → D-layer audited (post-hoc review, has dedicated write CLI)
#   extended_degraded → D-layer audited (no write CLI yet, perpetually degraded)
sanctum_governance:
  enabled: true
  registry_ref: "memory/fact_governance.yml → sanctum_registry"
  scripts:
    audit: "python3 scripts/sanctum_audit.py        # if installed"
    tag:   "python3 scripts/sanctum_tag.py <path>   # if installed"
    metrics: "python3 scripts/sanctum_metrics.py    # if installed"
  enforcement: "audit-only by default; promote to friction when CLIs cover writes"

---

# Brain Region Memory — neuro-anatomical file partitioning
# Manifest: memory/brain_region_manifest.yml (auto-generated by memory_region_manifest_build.py)
# Refresh:  bash scripts/memory_region_refresh_tick.sh   (weekly)
brain_regions:
  enabled: false   # set true after first manifest build
  manifest: "memory/brain_region_manifest.yml"
  config:   "memory/brain_region_config.yml"
  overrides: "memory/brain_region_overrides.yml"

---

tools:
  last_updated: "{{DATE}}"
  # Add your active tools here. Example:
  # tool_name:
  #   status: "installed"
  #   purpose: "What it does"
  #   key_commands:
  #     command_name: "the command"
